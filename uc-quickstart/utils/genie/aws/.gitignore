# Local import IDs (copy from import_ids.env.example)
import_ids.env

# Legacy helper links inside env workspaces
envs/*/*.tf
envs/*/*.py
envs/*/ABAC_PROMPT.md
envs/*/scripts
envs/*/.terraform.lock.hcl
envs/*/data_access/auth.auto.tfvars
envs/*/data_access/env.auto.tfvars
envs/*/data_access/.terraform.lock.hcl

# Terraform state (may contain secrets)
# Applies to nested env directories too (for example envs/dev/.terraform/).
*.tfstate
*.tfstate.backup
.terraform/

# User-specific credentials (only track the .example)
auth.auto.tfvars

# Auto-fetched DDLs in workspace envs (user-specific)
ddl/_fetched.sql
envs/*/ddl/_fetched.sql

# Local apply fingerprint files (ephemeral, machine-specific)
envs/*/.*.apply.sha
envs/*/data_access/.*.apply.sha

# AI-generated output in workspace envs (user-specific)
generated/
masking_functions.sql
# Re-include the deployed/split masking SQL (safe to commit; not a secret).
# The generated draft (generated/masking_functions.sql) stays ignored via generated/ above.
!envs/*/data_access/masking_functions.sql

# Auto-created Genie Space ID (managed by Terraform lifecycle)
.genie_space_id
envs/*/.genie_space_id_*

# Provisioned test environment state + credentials (contain secrets)
scripts/account-admin.env
scripts/.test_env_state.json

# Isolated integration-test environment (written by provision_test_env.py)
envs/test/

# Sandbox evaluation environments (contain credentials)
envs/sandbox_eval/
envs/sandbox_eval2/
envs/sandbox_eval3/
